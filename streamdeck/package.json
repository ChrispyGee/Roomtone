{
  "name": "roomtone-streamdeck",
  "version": "0.2.0",
  "private": true,
  "description": "An experimental Stream Deck plugin for Roomtone",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p .",
    "validate": "streamdeck validate io.github.chrispygee.roomtone.sdPlugin",
    "pack": "node build.mjs && streamdeck pack io.github.chrispygee.roomtone.sdPlugin --output . --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.6"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
